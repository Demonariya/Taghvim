{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build:windows"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "تقویم",
        "url": "index.html",
        "width": 390,
        "height": 780,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "autostart": {},
    "global-shortcut": {}
  }
}
